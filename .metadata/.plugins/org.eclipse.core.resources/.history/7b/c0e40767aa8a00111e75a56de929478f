package core_practices;

public class array {

	public static void main(String[] args) {

		        // Creating objects
		        Aeroplane one = new Aeroplane();
		        Aeroplane two = new Aeroplane();

		        // Assigning values
		        one.name = "AIR INDIA";
		        one.pilot = "ABC";

		        two.name = "INDIGO";
		        two.pilot = "DEF";

		        // Calling methods
		        one.takeoff();
		        two.takeoff();
		    }
		}

		class Aeroplane {

		    // Instance variables
		    String name;
		    String pilot;

		    // Non-static method
		    public void takeoff() {
		        System.out.println("Plane Name : " + name);
		        System.out.println("Pilot Name : " + pilot);
		        System.out.println("Plane is taking off...");
		        System.out.println();
		    }
		}
	


